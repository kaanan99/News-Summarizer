datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model UserAccount {
  uid Int @id @default(autoincrement())
  email String @unique
  first_name String
  last_name String
  is_active Boolean @default(true)

  @@index(fields: [email])
  @@index(fields: [is_active])
}

model GeneartedHeadline {
  gid Int @id @default(autoincrement())
  headline_text String
  date_added DateTime
  tid Int
  topic_relation Topic @relation(fields: [tid], references: [tid])
  group Int

  @@unique([headline_text, date_added])

  @@index([date_added])
  @@index([date_added, tid])
  @@index([date_added, tid, group])
}

model RawHeadline {
  rid Int @id @default(autoincrement())
  headline_text String
  headline_url String
  date_added DateTime
  tid Int
  topic_relation Topic @relation(fields: [tid], references: [tid])
  group Int

  @@unique([headline_text, headline_url])

  @@index([date_added])
  @@index([date_added, tid])
  @@index([date_added, tid, group])
}

model Topic {
  tid Int @id @default(autoincrement())
  topic_type String @unique
  topic_key String @unique
  generated_headlines_relation GeneartedHeadline[]
  raw_headline_relation RawHeadline[]

  @@index([topic_type])
}